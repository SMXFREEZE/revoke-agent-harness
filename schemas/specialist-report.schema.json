{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://revoke.local/schemas/specialist-report.schema.json",
  "title": "REVOKE specialist report",
  "type": "object",
  "additionalProperties": false,
  "required": ["role", "caseId", "status", "confidence", "evidence", "findings", "blockers"],
  "properties": {
    "role": {
      "enum": ["recall_sentinel", "catalog_resolver", "exposure_analyst", "adversarial_verifier"]
    },
    "caseId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["complete", "blocked", "contradicted"] },
    "confidence": { "enum": ["high", "manual_review", "insufficient"] },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceUrl", "publisher", "retrievedAt", "sha256"],
        "properties": {
          "sourceUrl": { "type": "string", "format": "uri" },
          "publisher": { "type": "string", "minLength": 1 },
          "retrievedAt": { "type": "string", "format": "date-time" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "findings": { "type": "array", "items": { "type": "object" } },
    "blockers": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "inputSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
